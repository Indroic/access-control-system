# URLs de conexión
DATABASE_URL=postgresql://postgres:password@postgres:5432/access-control-system
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:password@postgres:5432/access-control-system

# ─── Backend & Auth (Secretos) ───────────────────────────────────────────────
NODE_ENV=production
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-secret!!
ADMIN_SETUP_SECRET=super-secret-admin-setup-key-123456
INTERNAL_API_KEY=change-me-to-a-safe-internal-secret-key-12345!!

# ─── Frontend (Web) ──────────────────────────────────────────────────────────
PORT=3001

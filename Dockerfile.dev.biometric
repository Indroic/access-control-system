# ─── Dev image: Python biometric API ────────────────────────────────────────
# Source is volume-mounted by docker-compose.override.yml; this image carries
# Python + uv + the heavy native build toolchain InsightFace/onnxruntime need.
# ────────────────────────────────────────────────────────────────────────────

FROM python:3.14

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    libopenblas-dev \
    liblapack-dev \
    libx11-dev \
    libboost-python-dev \
    libboost-thread-dev \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgl1 \
    libgomp1 \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY apps/biometric-api/pyproject.toml apps/biometric-api/uv.lock ./

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

EXPOSE 8000

# Real command is supplied by docker-compose.override.yml (uv sync + uvicorn --reload)
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]

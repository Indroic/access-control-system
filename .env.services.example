# ─── Base de Datos (Infra) ───────────────────────────────────────────────────
POSTGRES_DB=${{project.POSTGRES_DB}}
POSTGRES_USER=${{project.POSTGRES_USER}}
POSTGRES_PASSWORD=${{project.POSTGRES_PASSWORD}}

# URLs de conexión
DATABASE_URL=${{project.DATABASE_URL}}
ASYNC_DATABASE_URL=${{project.ASYNC_DATABASE_URL}}

# ─── Backend & Auth (Secretos) ───────────────────────────────────────────────
NODE_ENV=${{project.NODE_ENV}}
BETTER_AUTH_SECRET=${{project.BETTER_AUTH_SECRET}}
ADMIN_SETUP_SECRET=${{project.ADMIN_SETUP_SECRET}}
INTERNAL_API_KEY=${{project.INTERNAL_API_KEY}}

# ─── Frontend (Web) ──────────────────────────────────────────────────────────
PORT=${{project.PORT}}

# ─── Database (PostgreSQL + pgvector) ─────────────────────────────────────────
# Variable OBLIGATORIA. A partir de ella `config.py` deriva las URLs síncrona
# (Alembic / psycopg2) y asíncrona (motor async / asyncpg). Acepta los esquemas
# `postgresql://`, `postgres://` o con driver explícito (`postgresql+asyncpg://`).
DATABASE_URL=postgresql://postgres:password@localhost:5432/access-control-system

# ─── Better Auth integration ──────────────────────────────────────────────────
# Internal URL used to verify tokens against the Hono server
# In Docker use the service name: http://server:3000/api/auth
BETTER_AUTH_URL=http://localhost:3000/api/auth

# JWT validation — must match the public URL seen by the browser
BETTER_AUTH_ISSUER=http://localhost:3000
BETTER_AUTH_AUDIENCE=http://localhost:3000

# Algorithm used by Better Auth to sign JWTs
BETTER_AUTH_JWT_ALGORITHM=RS256

# Optional: explicit JWKS endpoint. Defaults to {BETTER_AUTH_URL}/jwks
# BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks

# ─── Hardware ─────────────────────────────────────────────────────────────────
# Serial port for the Arduino door controller
# Linux: /dev/ttyUSB0  |  Windows: COM3
ARDUINO_PORT=/dev/ttyUSB0

# ─── Detección de logins biométricos sospechosos ──────────────────────────────
ANOMALY_MIN_SAMPLES=20
ANOMALY_K=2.0
ANOMALY_MIN_R=0.35
ANOMALY_HISTORY_DAYS=90

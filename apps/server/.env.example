# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/access-control-system

# ─── Better Auth ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-32-character-secret

# Public URL of this server (used for cookies, redirects and token issuer)
BETTER_AUTH_URL=http://localhost:3000

# ─── Services ─────────────────────────────────────────────────────────────────
BIOMETRIC_API_URL=http://localhost:8000

# Allowed CORS origin (Next.js frontend)
CORS_ORIGIN=http://localhost:3001

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development

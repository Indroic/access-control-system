{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "tsx watch src/index.ts",
		"start": "node dist/index.mjs",
		"test": "vitest run"
	},
	"dependencies": {
		"@access-control-system/api": "workspace:*",
		"@access-control-system/auth": "workspace:*",
		"@access-control-system/db": "workspace:*",
		"@access-control-system/env": "workspace:*",
		"@hono/node-server": "^1.14.4",
		"@hono/trpc-server": "^0.4.0",
		"@trpc/server": "catalog:",
		"better-auth": "catalog:",
		"dotenv": "catalog:",
		"drizzle-orm": "catalog:",
		"exceljs": "^4.4.0",
		"hono": "catalog:",
		"web-push": "^3.6.7",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@access-control-system/config": "workspace:*",
		"@types/node": "^22.13.14",
		"@types/web-push": "^3.6.4",
		"tsdown": "^0.21.9",
		"tsx": "^4.19.2",
		"typescript": "catalog:",
		"vitest": "^4.1.7"
	}
}
